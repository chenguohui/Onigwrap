<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!--
      The Loongnix service index is served over HTTPS, but its PackagePublish
      endpoint is advertised as http://nuget.loongnix.cn/api/v2/package.
      NuGet 6.12+ refuses HTTP sources unless allowInsecureConnections is set.
    -->
    <add key="loongnix" value="https://nuget.loongnix.cn/v3/index.json" allowInsecureConnections="true" />
  </packageSources>
</configuration>
